    "Original" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原图"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の写真"
          }
