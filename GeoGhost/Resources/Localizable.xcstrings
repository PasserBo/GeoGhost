        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。この作品はワールドマップに公開されているため、同時に取り下げられるようオンラインのときだけ削除できます。"
          }
        }
      }
    },
    "You've reached this month's publishing limit. It resets on the 1st." : {
