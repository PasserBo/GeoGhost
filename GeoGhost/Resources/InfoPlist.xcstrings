{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - NSCameraUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost uses the camera to capture stickers, graffiti and murals you find on the street."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost 使用相机拍摄你在街头发现的贴纸、涂鸦和壁画。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost は街で見つけたステッカー・グラフィティ・壁画を撮影するためにカメラを使用します。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - NSLocationWhenInUseUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost records where you found each piece so it can appear on your map."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost 会记录每件作品的发现地点，让它出现在你的地图上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost は各作品を見つけた場所を記録し、マップに表示します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - NSPhotoLibraryAddUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost saves exported stickers to your photo library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost 会把导出的贴纸保存到你的相册。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeoGhost は書き出したステッカーを写真ライブラリに保存します。"
          }
        }
      }
    },
