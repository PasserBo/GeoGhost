GG_SUPABASE_ANON_KEY = sb_publishable_vqPaWBSHJSWwBlyJZwjmBg_ws9h6UBc
GG_ONLINE_API_URL = https:/$()/geoghost-api.passerbo.workers.dev
GG_IMAGE_BASE_URL = https:/$()/geoghost-api.passerbo.workers.dev/v1/images
