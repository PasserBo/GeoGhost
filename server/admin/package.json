{
  "name": "geoghost-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run vendor && wrangler deploy --dry-run --outdir dist",
    "vendor": "mkdir -p public/vendor && cp node_modules/libheif-js/libheif-wasm/libheif.js node_modules/libheif-js/libheif-wasm/libheif.wasm public/vendor/"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "libheif-js": "^1.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
